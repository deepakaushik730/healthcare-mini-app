<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet" href="/css/style.css">
  <title>Health Form</title>
</head>
<body>
  <div class="card" style="position:relative">
  <a href="/dashboard" class="close-btn">&times;</a>
    <h2>Health Assessment</h2>

    <form method="post" action="/health">
      <label>Sleep Quality (1-5)</label>
      <input type="number" name="sleep" min="1" max="5" required>

      <label>Stress Level (1-5)</label>
      <input type="number" name="stress" min="1" max="5" required>

      <label>Tiredness Throughout Day (1-5)</label>
      <input type="number" name="tiredness" min="1" max="5" required>

      <label>Appetite</label>
      <select name="appetite">
        <option value="low">Low</option>
        <option value="medium">Medium</option>
        <option value="high">High</option>
      </select>

      <label>Activity Level</label>
      <select name="activity">
        <option value="low">Low</option>
        <option value="medium">Medium</option>
        <option value="high">High</option>
      </select>

      <button type="submit">Submit</button>
    </form>
  </div>
</body>
</html>
